# 복사해서 .env 로 저장하고 값을 채우세요. .env 는 커밋되지 않습니다.

# 서버 포트
PORT=3000

# LLM provider — claude(기본) 또는 openai
LLM_PROVIDER_STAGE_A=claude
LLM_PROVIDER_STAGE_B=claude
LLM_MODEL_STAGE_A=claude-sonnet-5
LLM_MODEL_STAGE_B=claude-sonnet-5

# API 키 (소스에 하드코딩 금지)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stage B 자동 검증 루프 최대 재시도
AUTOFIX_MAX_RETRIES=3

# true 면 LLM 호출 없이 결정론적 폴백 변환기만 사용
USE_DETERMINISTIC_ONLY=false
