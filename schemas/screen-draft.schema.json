{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hdsproject/schemas/screen-draft.schema.json",
  "title": "화면정의 payload (프론트엔드 → 백엔드)",
  "type": "object",
  "additionalProperties": false,
  "required": ["systemId", "mode", "canvas", "shapes"],
  "properties": {
    "systemId": { "type": "string", "minLength": 1 },
    "systemName": { "type": "string" },
    "mode": { "enum": ["new", "edit"] },
    "template": { "enum": ["list", "detail", "form", "popup", "main", "blank"] },
    "baseScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "screenName": { "type": "string" },
    "background": {
      "type": "string",
      "description": "변경화면 캡처 이미지 data URL — 생성 결과에서 컴포넌트 뒤 배경으로 표시"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "shapes": {
      "type": "array",
      "items": { "$ref": "#/$defs/shape" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "new" } } },
      "then": { "required": ["template"] }
    },
    {
      "if": { "properties": { "mode": { "const": "edit" } } },
      "then": { "required": ["baseScreen"] }
    }
  ],
  "$defs": {
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": [
            "title", "label", "input", "select", "radio", "date", "check", "text", "file",
            "list", "pager", "tab", "image", "button", "divider", "area"
          ]
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string" },
        "items": { "type": "string" },
        "required": { "type": "boolean" },
        "group": { "type": "string", "description": "같은 값을 가진 요소들은 한 그룹(함께 이동·선택)" },
        "src": { "type": "string", "description": "type=image 일 때 이미지 data URL 또는 URL" },
        "desc": { "type": "string", "description": "요소 설명 — 결과 화면에서 클릭 시 안내 문구로 표시(주로 button)" },
        "fontSize": {
          "type": "number", "minimum": 8, "maximum": 48,
          "description": "스케치 캔버스에서 지정한 글자 크기(px) — 참고용이며 생성 결과의 표준 컴포넌트 스타일에는 적용되지 않는다"
        }
      }
    }
  }
}
