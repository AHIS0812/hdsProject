{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hdsproject/schemas/generation-result.schema.json",
  "title": "생성결과 (백엔드 → 프론트엔드)",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "preview": {
      "type": "object",
      "required": ["html"],
      "properties": { "html": { "type": "string" } }
    },
    "code": {
      "type": "object",
      "properties": {
        "websquareXml": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string" },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "converter": { "type": "string" },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "propagatedRequired": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "log": { "type": "string" },
        "details": {}
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "required": ["preview", "code"] }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"] }
    }
  ]
}
