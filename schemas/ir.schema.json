{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hdsproject/schemas/ir.schema.json",
  "title": "정규화 IR (Stage A 출력)",
  "type": "object",
  "required": ["screen", "layout", "components"],
  "properties": {
    "screen": {
      "type": "object",
      "required": ["systemId", "mode", "title"],
      "properties": {
        "systemId": { "type": "string" },
        "mode": { "enum": ["new", "edit"] },
        "template": { "enum": ["list", "detail", "form", "popup", "main", "blank"] },
        "baseScreenId": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["section", "grid", "row", "container"] },
          "children": { "type": "array", "items": { "type": "string" } },
          "props": { "type": "object" }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "parentId": { "type": "string" },
          "componentKey": { "type": ["string", "null"] },
          "tokenKeys": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "object" },
          "position": { "type": "object" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "uncertain": { "type": "boolean" }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": { "type": "string" },
          "targetId": { "type": "string" },
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
