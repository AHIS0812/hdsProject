{
  "$comment": "요소 타입 → WebSquare 매핑 규칙. 개발지시서 §7. 시스템별 차이는 override.<systemId>.json 로. id 접두어는 사내 '웹스퀘어 개발가이드' 2.1 Naming Rule 을 따름(InputBox/InputCalendar=ipt, SelectBox=cmb, Radio=rdo, CheckBox=cbx, Textarea=txt, Upload=upl, Grid=grd, PageList=pag, TabControl=tab, Image=img, Trigger=btn, Group=grp, Output(caption)=cap). name 부분은 자동 생성이라 읽기순 번호를 그대로 쓴다. (requiredClass 명칭은 여전히 백엔드 검증 대상 — A-3b)",
  "default": {
    "input":       { "tag": "w2:inputBox",  "attrs": { "id": "ipt_{n}" }, "requiredClass": "w2input_essential" },
    "select":      { "tag": "w2:selectBox", "attrs": { "id": "cmb_{n}", "dataList": "dl{n}" }, "options": "{items}", "requiredClass": "w2selectbox_essential" },
    "radio":       { "tag": "w2:radiobutton", "attrs": { "id": "rdo_{n}", "dataList": "dl{n}" }, "options": "{items}" },
    "date":        { "tag": "w2:calendar",  "attrs": { "id": "ipt_{n}", "displayFormat": "yyyy-MM-dd" }, "requiredClass": "w2input_essential" },
    "check":       { "tag": "w2:checkbox",  "attrs": { "id": "cbx_{n}", "label": "{label}" } },
    "text":        { "tag": "w2:textarea",  "attrs": { "id": "txt_{n}" }, "requiredClass": "w2textarea_essential" },
    "file":        { "tag": "w2:fileUpload", "attrs": { "id": "upl_{n}", "title": "{label}" } },
    "list":        { "tag": "w2:gridView",  "attrs": { "id": "grd_{n}", "dataList": "dl{n}" }, "columnTag": "w2:gridColumn", "columns": "{items}" },
    "pager":       { "tag": "w2:pagination", "attrs": { "id": "pag_{n}", "pageListCnt": 10 } },
    "tab":         { "tag": "w2:tabControl", "attrs": { "id": "tab_{n}" }, "tabItemTag": "w2:tabItem", "items": "{items}" },
    "image":       { "tag": "w2:image",     "attrs": { "id": "img_{n}", "alt": "{label}" } },
    "button":      { "tag": "w2:trigger",   "attrs": { "id": "btn_{n}", "value": "{label}", "onclick": "fn_{n}" } },
    "divider":     { "tag": "w2:group",     "attrs": { "id": "grp_{n}", "class": "w2group_divider" } },
    "label":       { "tag": "w2:textbox",   "attrs": { "id": "cap_{n}", "value": "{label}" } },
    "title":       { "tag": "w2:textbox",   "attrs": { "id": "cap_{n}", "value": "{label}" } },
    "area":        { "tag": "w2:group",     "attrs": { "id": "grp_{n}" } }
  }
}
